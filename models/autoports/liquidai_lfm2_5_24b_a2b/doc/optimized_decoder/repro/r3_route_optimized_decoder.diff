+        # K*E-deep contractions: in0_block_w = all K tiles (default config: 1 tile/step, 5.2 vs 2.1 us)
+        kt = K * E // TILE
+        self.v3_deep_cfg = lambda n: ttnn.MatmulMultiCoreReuseMultiCast1DProgramConfig(
