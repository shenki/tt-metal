+            tilek = torch.zeros(K, b * K)  # [K, b*K]: k-th choice -> slot j*K + k of every user j
+            for j in range(b):
+                rep[j, j * K : (j + 1) * K] = 1.0
+                tilek[:, j * K : (j + 1) * K] = torch.eye(K)
+            self.c_rep[b], self.c_tilek[b] = _as_tt(rep, md), _as_tt(tilek, md)
